# Production-only: the live POTD ratings Worker. Consumed by client/src/potd.ts as
# import.meta.env.VITE_POTD_API and baked into the production Pages bundle (not a secret — it's a
# public endpoint, and CORS on the Worker is allow-listed to the Pages origin). Dev/preview builds
# leave this unset, so ratings queue locally there.
VITE_POTD_API=https://sokopelago-potd.sokopeligo.workers.dev
