{
  "name": "sokopelago-client",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "Sokopelago — browser Sokoban client for Archipelago",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.21",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.4",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.61.1",
    "vite": "^6.0.7",
    "vite-plugin-static-copy": "^2.2.0",
    "vitest": "^3.0.2"
  },
  "dependencies": {
    "archipelago.js": "^2.1.0"
  }
}
